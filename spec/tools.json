                "default": null,
                "title": "Proposer Ref"
              }
            },
            "required": [
              "target",
              "ops"
            ],
            "title": "Patch",
            "type": "object"
          }
        },
        "properties": {
          "patch": {
            "$ref": "#/$defs/Patch"
          }
        },
        "required": [
          "patch"
        ],
        "title": "applyArguments"
      },
      "output_schema": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "parent_ids": {
            "items": {
              "type": "string"
            },
            "title": "Parent Ids",
            "type": "array"
          },
          "patch_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Patch Id"
          },
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Message"
          },
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Metrics",
            "type": "object"
          }
        },
        "required": [
          "id",
          "target",
          "content_hash",
          "created_at"
        ],
        "title": "Snapshot",
        "type": "object"
      }
    },
