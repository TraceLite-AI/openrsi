              "call_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Call Id"
              },
              "is_error": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Is Error"
              },
              "metadata": {
                "additionalProperties": true,
                "title": "Metadata",
                "type": "object"
              }
            },
            "required": [
              "type"
            ],
            "title": "Step",
            "type": "object"
          },
          "Task": {
            "additionalProperties": true,
            "description": "一道题。split 决定它能流向哪里：只有 train 的轨迹可以进入归因和提案。",
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "input": {
                "default": null,
                "title": "Input"
              },
              "split": {
                "default": "train",
                "enum": [
                  "train",
                  "holdout",
                  "anchor",
                  "final"
                ],
                "title": "Split",
                "type": "string"
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "title": "Tags",
                "type": "array"
              },
              "env_ref": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Env Ref"
              },
              "metadata": {
                "additionalProperties": true,
                "title": "Metadata",
                "type": "object"
              }
            },
            "required": [
              "id"
            ],
            "title": "Task",
            "type": "object"
          },
          "Trajectory": {
            "additionalProperties": true,
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "task_id": {
                "title": "Task Id",
                "type": "string"
              },
              "steps": {
                "items": {
                  "$ref": "#/$defs/Step"
                },
                "title": "Steps",
                "type": "array"
              },
              "output": {
                "default": null,
                "title": "Output"
              },
              "used_items": {
                "description": "本次用到的 memory 条目 id",
                "items": {
                  "type": "string"
                },
                "title": "Used Items",
                "type": "array"
              },
              "snapshot_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "跑在哪个快照上",
                "title": "Snapshot Id"
              },
              "metadata": {
                "additionalProperties": true,
                "title": "Metadata",
                "type": "object"
              }
            },
            "required": [
              "id",
              "task_id"
            ],
            "title": "Trajectory",
            "type": "object"
          }
        },
        "properties": {
          "task": {
            "$ref": "#/$defs/Task"
          },
          "trajectory": {
            "$ref": "#/$defs/Trajectory"
          },
