{
  "protocol": "openrsi/0.1",
  "tools": [
    {
      "name": "rsi_component_info",
      "kind": "component",
      "required": true,
      "description": "报告组件名、版本、协议版本和实现的组件类型。",
      "input_schema": {
        "type": "object",
        "properties": {},
        "title": "infoArguments"
      },
      "output_schema": {
        "additionalProperties": true,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "protocol": {
            "default": "openrsi/0.1",
            "title": "Protocol",
            "type": "string"
          },
          "kinds": {
            "items": {
              "type": "string"
            },
            "title": "Kinds",
            "type": "array"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "name",
          "version",
          "kinds",
          "tools"
        ],
        "title": "ComponentInfo",
        "type": "object"
      }
    },
    {
      "name": "rsi_evidence_collect",
