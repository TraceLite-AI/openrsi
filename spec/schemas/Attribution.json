{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrsi.dev/schemas/0.2/Attribution.json",
  "$defs": {
    "AttributionTarget": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "enum": [
            "step",
            "item",
            "component",
            "patch",
            "rubric"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "weight": {
          "description": "负数是责任，正数是功劳",
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Weight",
          "type": "number"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "kind",
        "ref",
        "weight"
      ],
      "title": "AttributionTarget",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "episode_id": {
      "description": "对应 trajectory.id",
      "title": "Episode Id",
      "type": "string"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/AttributionTarget"
      },
      "title": "Targets",
      "type": "array"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    }
  },
  "required": [
    "episode_id",
    "method"
  ],
  "title": "Attribution",
  "type": "object"
}
