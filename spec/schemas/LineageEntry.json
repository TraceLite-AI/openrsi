{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrsi.dev/schemas/0.4/LineageEntry.json",
  "$defs": {
    "GateCheck": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "GateCheck",
      "type": "object"
    },
    "GateDecision": {
      "additionalProperties": true,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/GateCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "candidate_id",
        "accepted"
      ],
      "title": "GateDecision",
      "type": "object"
    },
    "Patch": {
      "additionalProperties": true,
      "description": "对一个可进化体的修改。ops 的格式由可进化体的类型决定（memory 见 MemoryOp）。",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "ops": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Ops",
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "base_snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "期望的当前快照；不一致则拒绝，防止覆盖别人的修改",
          "title": "Base Snapshot"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "proposer_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposer Ref"
        }
      },
      "required": [
        "target",
        "ops"
      ],
      "title": "Patch",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "id": {
      "description": "快照 id",
      "title": "Id",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "parent_ids": {
      "items": {
        "type": "string"
      },
      "title": "Parent Ids",
      "type": "array"
    },
    "generation": {
      "default": 0,
      "title": "Generation",
      "type": "integer"
    },
    "status": {
      "enum": [
        "root",
        "accepted",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "patch": {
      "anyOf": [
        {
          "$ref": "#/$defs/Patch"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "snapshots": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "同时进化多个可进化体时，每个目标对应的快照 id（0.3）",
      "title": "Snapshots",
      "type": "object"
    },
    "task_scores": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "每道 holdout 题的分数（0.4）；环境格模式下键是 <task_id>@<cell_id>",
      "title": "Task Scores",
      "type": "object"
    },
    "env_cells": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "环境格模式下这次评估用到的格：格 id → 指纹（0.5 草案）",
      "title": "Env Cells",
      "type": "object"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "target",
    "status"
  ],
  "title": "LineageEntry",
  "type": "object"
}
