{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrsi.dev/schemas/0.4/MemoryOp.json",
  "$defs": {
    "Item": {
      "additionalProperties": true,
      "description": "memory 里的一条记录。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "kind": {
          "default": "note",
          "title": "Kind",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "Item",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "op": {
      "enum": [
        "add",
        "remove",
        "replace"
      ],
      "title": "Op",
      "type": "string"
    },
    "item": {
      "anyOf": [
        {
          "$ref": "#/$defs/Item"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Id"
    }
  },
  "required": [
    "op"
  ],
  "title": "MemoryOp",
  "type": "object"
}
