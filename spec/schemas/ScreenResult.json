{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrsi.dev/schemas/0.4/ScreenResult.json",
  "additionalProperties": true,
  "description": "评估前的筛查：和已经评估过的候选太像就不必再花评估成本（0.4）。",
  "properties": {
    "accept": {
      "title": "Accept",
      "type": "boolean"
    },
    "novelty": {
      "description": "1 表示全新，0 表示完全重复",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Novelty",
      "type": "number"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "accept",
    "novelty"
  ],
  "title": "ScreenResult",
  "type": "object"
}
