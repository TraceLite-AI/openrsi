{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrsi.dev/schemas/0.4/TellRequest.json",
  "additionalProperties": true,
  "properties": {
    "generation": {
      "title": "Generation",
      "type": "integer"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "task_scores": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "候选在每道 holdout 题上的分数（0.4）",
      "title": "Task Scores",
      "type": "object"
    },
    "proposer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "产生这个候选的提案器（0.4）",
      "title": "Proposer"
    }
  },
  "required": [
    "generation",
    "accepted"
  ],
  "title": "TellRequest",
  "type": "object"
}
