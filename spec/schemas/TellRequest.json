{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrsi.dev/schemas/0.3/TellRequest.json",
  "additionalProperties": true,
  "properties": {
    "generation": {
      "title": "Generation",
      "type": "integer"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    }
  },
  "required": [
    "generation",
    "accepted"
  ],
  "title": "TellRequest",
  "type": "object"
}
