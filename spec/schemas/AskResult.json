{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrsi.dev/schemas/0.2/AskResult.json",
  "additionalProperties": true,
  "properties": {
    "generation": {
      "title": "Generation",
      "type": "integer"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "下一代从哪个快照出发；None 表示停止",
      "title": "Parent Id"
    },
    "done": {
      "default": false,
      "title": "Done",
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "generation",
    "parent_id"
  ],
  "title": "AskResult",
  "type": "object"
}
