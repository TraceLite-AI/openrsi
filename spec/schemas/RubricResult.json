{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrsi.dev/schemas/0.4/RubricResult.json",
  "additionalProperties": true,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "skip",
        "error"
      ],
      "title": "Result",
      "type": "string"
    },
    "evidence_ids": {
      "description": "这条结论引用的证据",
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "weight": {
      "default": 1.0,
      "title": "Weight",
      "type": "number"
    },
    "required": {
      "default": false,
      "title": "Required",
      "type": "boolean"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    }
  },
  "required": [
    "id",
    "result"
  ],
  "title": "RubricResult",
  "type": "object"
}
