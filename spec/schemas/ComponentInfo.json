{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrsi.dev/schemas/0.2/ComponentInfo.json",
  "additionalProperties": true,
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "protocol": {
      "default": "openrsi/0.2",
      "title": "Protocol",
      "type": "string"
    },
    "kinds": {
      "items": {
        "type": "string"
      },
      "title": "Kinds",
      "type": "array"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "name",
    "version",
    "kinds",
    "tools"
  ],
  "title": "ComponentInfo",
  "type": "object"
}
